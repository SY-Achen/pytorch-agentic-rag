# ── Smart RAG Agent — Environment Variables ──
# Copy this file to .env and fill in your values before deploying.

# JWT Secret for authentication (change in production!)
JWT_SECRET=your-jwt-secret-change-me-in-production

# DeepSeek API Key (for reasoning/fallback)
# Leave empty to use only local embedding + rules
DEEPSEEK_API_KEY=

# Embedding model path (local cache preferred for offline deployment)
# Linux/Mac example: /root/.cache/modelscope/models/AI-ModelScope--bge-small-zh-v1.5/snapshots/master
# Windows example: C:/Users/Administrator/.cache/modelscope/models/AI-ModelScope--bge-small-zh-v1.5/snapshots/master
EMB_MODEL=/root/.cache/modelscope/models/AI-ModelScope--bge-small-zh-v1.5/snapshots/master

# Database directories (Docker volume mounts)
DB_DIR=/app/chroma_db

# Server settings
HOST_PORT=8000
DATA_PATH=./data
CHROMA_PATH=./chroma_db
UPLOAD_PATH=./uploads
