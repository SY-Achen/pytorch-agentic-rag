# ═══════════════════════════════════════════════════════════
# RAG Agent — Docker Deployment Template (2GB RAM instance)
# Copy to .env and fill in values before docker compose up
# ═══════════════════════════════════════════════════════════

# ── HTTP Port (default: 8000) ────────────────────────────
HOST_PORT=8000

# ── LLM API ──────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=your-model-name
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Fallback endpoint (optional)
DEEPSEEK_BASE_URL_FALLBACK=

# Route fallback timeout (seconds, default 20)
ROUTE_FALLBACK_TIMEOUT=20

# ── JWT Auth ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-string-in-production

# ── Browser / concurrency security ─────────────────────────
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 2C2G host: keep 1 worker because each worker can load an embedding model.
WEB_CONCURRENCY=1

# ── Cross-Encoder rerank (optional; leave empty until model is downloaded) ──
RERANK_MODEL=

# ── Data Mounts ──────────────────────────────────────────
DATA_PATH=./data

# ── Embedding Model ──────────────────────────────────────
# Path to BGE-small-zh-v1.5 snapshot inside container (/app/data persist across restarts)
# Pre-download on the server BEFORE docker compose up:
#   python download_emb_model.py --output ./data/models/bge-small-zh-v1.5
# Leave EMB_MODEL empty to auto-fallback to /app/data/models/bge-small-zh-v1.5/snapshots/master
EMB_MODEL=
